<Window x:Class="GodEx.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="GodEx" Height="760" Width="1120" MinHeight="680" MinWidth="980"
 WindowStartupLocation="CenterScreen" Background="#090D18" Foreground="#F4F6FF"
 FontFamily="Segoe UI" ResizeMode="CanResize">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AAB3CD"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,12"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,3"/>
  </Style>
  <Style x:Key="GlassCard" TargetType="Border">
   <Setter Property="Background" Value="#151B2B"/><Setter Property="BorderBrush" Value="#29324B"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/>
   <Setter Property="Padding" Value="22"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="#8B7CFF"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="24,14"/>
   <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><RadialGradientBrush GradientOrigin="0.8,0.1" Center="0.8,0.1" RadiusX="1" RadiusY="1"><GradientStop Color="#20204B" Offset="0"/><GradientStop Color="#090D18" Offset="1"/></RadialGradientBrush></Grid.Background>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#B00F1422" BorderBrush="#242B40" BorderThickness="0,0,1,0" Padding="20">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="4,8,0,34">
      <Border Width="38" Height="38" CornerRadius="13" Background="#8B7CFF" VerticalAlignment="Center">
       <TextBlock Text="G" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="GodEx" FontSize="21" FontWeight="Bold"/><TextBlock Text="PRIVATE NETWORK" FontSize="9" Foreground="#9AA6C5" CharacterSpacing="170"/></StackPanel>
     </StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="#687493" FontSize="10" Margin="12,0,0,8" CharacterSpacing="130"/>
     <Button Style="{StaticResource NavButton}" Background="#272747" Foreground="White" Content="◉   Обзор"/>
     <Button Style="{StaticResource NavButton}" Content="◎   Серверы" Click="Servers_Click"/>
     <Button Style="{StaticResource NavButton}" Content="⌁   Диагностика" Click="Diagnostics_Click"/>
     <TextBlock Text="ПРИЛОЖЕНИЕ" Foreground="#687493" FontSize="10" Margin="12,28,0,8" CharacterSpacing="130"/>
     <Button Style="{StaticResource NavButton}" Content="⚙   Настройки" Click="Settings_Click"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#1A2031" CornerRadius="14" Padding="12" Margin="0,20,0,0">
     <StackPanel><TextBlock Text="GODEX PREVIEW" Foreground="#A89FFF" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="Интерфейс в разработке" Foreground="#9AA6C5" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    </Border>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="34,28,34,30">
    <Grid Margin="0,0,0,28"><StackPanel><TextBlock Text="Панель управления" FontSize="27" FontWeight="Bold"/><TextBlock Text="Твоё подключение. Твои правила." Foreground="#9AA6C5" FontSize="13" Margin="0,5,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#182D2B" BorderBrush="#285A50" BorderThickness="1" CornerRadius="20" Padding="11,7"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#51D6A0" Margin="0,0,7,0"/><TextBlock Text="Приложение запущено" Foreground="#82E8C0" FontSize="11"/></StackPanel></Border></Grid>
    <Border Style="{StaticResource GlassCard}" Padding="28">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <Border Background="#242143" CornerRadius="20" Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,18"><TextBlock Text="✦" Foreground="#B7AEFF" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <TextBlock Text="Твоё соединение" FontSize="23" FontWeight="SemiBold"/>
       <TextBlock x:Name="StatusText" Text="Не подключено" Foreground="#AAB3CD" FontSize="14" Margin="0,7,0,22"/>
       <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="Подключить VPN  →" HorizontalAlignment="Left" Click="Connect_Click"/>
       <TextBlock Text="Пока доступен только интерфейс. VPN-туннель ещё не настроен." TextWrapping="Wrap" Foreground="#7F8AA8" FontSize="11" Margin="0,16,10,0"/>
      </StackPanel>
      <Grid Grid.Column="1" Width="190" Height="190" VerticalAlignment="Center" HorizontalAlignment="Center">
       <Ellipse Stroke="#302B5C" StrokeThickness="1" Margin="4"/><Ellipse Stroke="#383365" StrokeThickness="1" Margin="22"/><Ellipse Stroke="#5145A2" StrokeThickness="1" Margin="40"/>
       <Ellipse Width="92" Height="92" Fill="#25214A" Stroke="#8174FF" StrokeThickness="1.5"><Ellipse.Effect><DropShadowEffect Color="#8174FF" BlurRadius="35" ShadowDepth="0" Opacity="0.45"/></Ellipse.Effect></Ellipse>
       <TextBlock Text="✧" FontSize="48" Foreground="#C3BCFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Ellipse Width="7" Height="7" Fill="#9C91FF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,27,0"/>
       <Ellipse Width="5" Height="5" Fill="#66D9D0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,30"/>
      </Grid>
     </Grid>
    </Border>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource GlassCard}" Margin="0,0,7,0"><StackPanel><TextBlock Text="ТЕКУЩИЙ СЕРВЕР" Foreground="#929DBA" FontSize="10" CharacterSpacing="80"/><TextBlock x:Name="ServerText" Text="Не выбран" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Выбери точку подключения" Foreground="#929DBA" FontSize="11"/></StackPanel></Border>
     <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="7,0"><StackPanel><TextBlock Text="ЗАДЕРЖКА" Foreground="#929DBA" FontSize="10" CharacterSpacing="80"/><TextBlock Text="— ms" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Нет активного соединения" Foreground="#929DBA" FontSize="11"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="7,0,0,0"><StackPanel><TextBlock Text="ЗАЩИТА" Foreground="#929DBA" FontSize="10" CharacterSpacing="80"/><TextBlock Text="Неактивна" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="Туннель не настроен" Foreground="#929DBA" FontSize="11"/></StackPanel></Border>
    </Grid>
    <TextBlock Text="Быстрый доступ" FontSize="18" FontWeight="SemiBold" Margin="2,28,0,13"/>
    <UniformGrid Columns="2">
     <Border Style="{StaticResource GlassCard}" Margin="0,0,7,0"><StackPanel><TextBlock Text="◎  Выбрать сервер" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Просмотр доступных локаций" Foreground="#929DBA" FontSize="12" Margin="0,7,0,12"/><Button Content="Открыть серверы  ↗" HorizontalAlignment="Left" Background="#252B40" Foreground="White" BorderThickness="0" Padding="12,9" Cursor="Hand" Click="Servers_Click"/></StackPanel></Border>
     <Border Style="{StaticResource GlassCard}" Margin="7,0,0,0"><StackPanel><TextBlock Text="⌁  Проверить систему" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Состояние приложения и сети" Foreground="#929DBA" FontSize="12" Margin="0,7,0,12"/><Button Content="Запустить диагностику  ↗" HorizontalAlignment="Left" Background="#252B40" Foreground="White" BorderThickness="0" Padding="12,9" Cursor="Hand" Click="Diagnostics_Click"/></StackPanel></Border>
    </UniformGrid>
    <TextBlock Text="GodEx • ранняя версия • реальная VPN-защита пока не активна" Foreground="#65708D" FontSize="10" HorizontalAlignment="Center" Margin="0,24,0,0"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>

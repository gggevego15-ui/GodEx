<Window x:Class="GodEx.DiagnosticsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="GodEx — Диагностика" Height="760" Width="1000" MinHeight="650" MinWidth="820"
 WindowStartupLocation="CenterOwner" Background="#090D18" Foreground="#F4F6FF"
 FontFamily="Segoe UI" ResizeMode="CanResize">
 <Window.Resources>
  <Style x:Key="GlassCard" TargetType="Border">
   <Setter Property="Background" Value="#151B2B"/><Setter Property="BorderBrush" Value="#29324B"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="20"/>
  </Style>
  <Style x:Key="RunButton" TargetType="Button">
   <Setter Property="Background" Value="#8B7CFF"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.Background><RadialGradientBrush GradientOrigin="0.9,0.0" Center="0.9,0.0" RadiusX="1" RadiusY="1"><GradientStop Color="#20204B" Offset="0"/><GradientStop Color="#090D18" Offset="1"/></RadialGradientBrush></Grid.Background>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="30,26,30,28">
    <Grid Margin="0,0,0,24">
     <StackPanel>
      <TextBlock Text="Сетевая диагностика" FontSize="28" FontWeight="Bold"/>
      <TextBlock Text="Проверка DNS, маршрутов и доступности сети Windows" Foreground="#9AA6C5" FontSize="13" Margin="0,6,0,0"/>
     </StackPanel>
     <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1A2031" CornerRadius="12" Padding="10,7">
      <TextBlock Text="GODEX • LIVE CHECKS" Foreground="#B8AEFF" FontSize="10" FontWeight="SemiBold"/>
     </Border>
    </Grid>
    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Состояние проверок" FontSize="18" FontWeight="SemiBold"/>
       <TextBlock x:Name="SummaryText" Text="Проверки ещё не запускались" Foreground="#9AA6C5" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <Button x:Name="RunButton" Grid.Column="1" Content="Запустить проверки  ↗" Style="{StaticResource RunButton}" VerticalAlignment="Center" Click="RunChecks_Click"/>
     </Grid>
    </Border>
    <UniformGrid Columns="3" Margin="0,0,0,14">
     <Border Style="{StaticResource GlassCard}" Margin="0,0,7,0">
      <StackPanel>
       <TextBlock Text="DNS" Foreground="#9AA6C5" FontSize="11" FontWeight="SemiBold"/>
       <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
        <Ellipse x:Name="DnsDot" Width="10" Height="10" Fill="#687493" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="DnsStatus" Text="Ожидание" FontSize="16" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="DnsDetail" Text="Разрешение имён доменов" Foreground="#9AA6C5" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource GlassCard}" Margin="7,0">
      <StackPanel>
       <TextBlock Text="МАРШРУТЫ" Foreground="#9AA6C5" FontSize="11" FontWeight="SemiBold"/>
       <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
        <Ellipse x:Name="RouteDot" Width="10" Height="10" Fill="#687493" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="RouteStatus" Text="Ожидание" FontSize="16" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="RouteDetail" Text="Активные интерфейсы и IPv4-маршруты" Foreground="#9AA6C5" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource GlassCard}" Margin="7,0,0,0">
      <StackPanel>
       <TextBlock Text="HTTPS" Foreground="#9AA6C5" FontSize="11" FontWeight="SemiBold"/>
       <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
        <Ellipse x:Name="HttpsDot" Width="10" Height="10" Fill="#687493" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="HttpsStatus" Text="Ожидание" FontSize="16" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="HttpsDetail" Text="HTTPS-запрос к контрольному адресу" Foreground="#9AA6C5" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </UniformGrid>
    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="DNS — подробности" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="DnsOutput" Text="Нажми «Запустить проверки», чтобы выполнить DNS-запросы." Foreground="#B9C3DC" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
     <StackPanel>
      <TextBlock Text="Маршруты и сетевые адаптеры" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="RouteOutput" Text="Здесь появятся активные адаптеры, шлюзы и выбранные строки таблицы IPv4." Foreground="#B9C3DC" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource GlassCard}">
     <StackPanel>
      <TextBlock Text="HTTPS — подробности" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="HttpsOutput" Text="Ожидание проверки." Foreground="#B9C3DC" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <TextBlock Text="Важно: успешные тесты подтверждают общую доступность сети, но сами по себе не доказывают, что весь трафик идёт через VPN. Сопоставь таблицу маршрутов с VPN-интерфейсом." Foreground="#7F8AA8" FontSize="11" TextWrapping="Wrap" Margin="4,18,4,0"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
